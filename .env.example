# Database (Railway Postgres)
DATABASE_URL="postgresql://user:password@host:5432/upload_and_forget"

# App
APP_URL="http://localhost:3000"
# Simple shared-secret gate since this is single-user. Set any string.
ADMIN_PASSWORD="change-me"

# Cloudflare R2 (S3-compatible) — audio + video storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="upload-and-forget"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# Anthropic — caption / hashtag / SEO copywriting
ANTHROPIC_API_KEY=""

# Runway — AI visualizer video generation
RUNWAY_API_KEY=""
RUNWAY_API_BASE="https://api.dev.runwayml.com/v1"

# Stripe — checkout + payouts
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# YouTube Data API v3 (OAuth refresh token, single-user)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# Meta Graph API (Instagram Reels + bio link update)
META_ACCESS_TOKEN=""
META_IG_BUSINESS_ACCOUNT_ID=""

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCESS_TOKEN=""
